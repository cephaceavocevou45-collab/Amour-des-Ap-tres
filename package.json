{
  "name": "paroisse-amour-des-apotres",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@angular/service-worker": "20.3.34",
    "@playwright/test": "^1.63.0",
    "dotenv": "16.6.1",
    "playwright": "1.64.1"
  },
  "scripts": {
    "dev:web": "npm --workspace @paroisse/web start",
    "dev:api": "npm --workspace @paroisse/api run start:dev",
    "start": "npm run start:prod --workspace @paroisse/api",
    "build": "npm run build --workspace @paroisse/api && npm run build --workspace @paroisse/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:tools && npm run test --workspaces --if-present",
    "test:tools": "node --test scripts/*.test.cjs infra/*.test.cjs",
    "security:scan": "node scripts/secret-scan.cjs",
    "audit:production": "node scripts/audit-production.cjs",
    "test:e2e": "npm run test:e2e --workspace @paroisse/api",
    "test:bootstrap": "node scripts/test-bootstrap.cjs",
    "test:playwright": "playwright test",
    "test-db:diagnose": "node scripts/test-db-diagnose.cjs",
    "test-db:setup": "node scripts/test-db-setup.cjs",
    "backup:create": "sh infra/backup.sh",
    "backup:restore-test": "sh infra/backup-restore-test.sh",
    "db:least-privilege": "node scripts/db-least-privilege.cjs",
    "test:production-deps": "node scripts/test-production-deps.cjs",
    "test:railway-image": "node scripts/test-railway-image-runtime.cjs"
  }
}
