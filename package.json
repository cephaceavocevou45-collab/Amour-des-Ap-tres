{
  "name": "paroisse-amour-des-apotres",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {"@angular/service-worker": "^20.0.0"},
  "scripts": {
    "dev:web": "npm --workspace @paroisse/web start",
    "dev:api": "npm --workspace @paroisse/api run start:dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @paroisse/api",
    "backup:create": "sh infra/backup.sh",
    "backup:restore-test": "sh infra/backup-restore-test.sh"
  }
}
