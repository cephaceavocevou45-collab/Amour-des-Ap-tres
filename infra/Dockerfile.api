FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run prisma:generate --workspace @paroisse/api && npm run build --workspace @paroisse/api
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node","apps/api/dist/apps/api/src/main.js"]
