FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache postgresql-client
COPY infra/backup-runtime/package.json infra/backup-runtime/package-lock.json ./
RUN npm ci --omit=dev --omit=optional
COPY infra/backup-s3.cjs infra/backup-crypto.cjs infra/
USER node
CMD ["node", "infra/backup-s3.cjs", "create"]
