FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build --workspace @paroisse/web

FROM nginxinc/nginx-unprivileged:1.27-alpine
ENV API_PRIVATE_HOST=api.railway.internal:3000 \
    NGINX_ENVSUBST_FILTER=^API_PRIVATE_HOST$
COPY infra/nginx-main.railway.conf /etc/nginx/nginx.conf
COPY infra/railway-web.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist/web/browser /usr/share/nginx/html
USER 101:101
EXPOSE 8080
