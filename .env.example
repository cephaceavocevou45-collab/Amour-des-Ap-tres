# URL de la base locale de développement (ne jamais utiliser pour les e2e).
DATABASE_URL=postgresql://app:change-me@localhost:5432/paroisse?schema=public
# URL exclusivement réservée aux tests ; son nom doit contenir « test ».
TEST_DATABASE_URL=postgresql://paroisse_test_user:change-me@localhost:5432/paroisse_test?schema=public
# Mot de passe choisi pour le rôle de test, uniquement si le script de provisionnement le demande.
PAROISSE_TEST_DB_PASSWORD=
# URL temporaire d'un administrateur PostgreSQL, utilisée uniquement par le script d'initialisation de la base de test.
PG_ADMIN_URL=
# Mot de passe PostgreSQL de l'application (Compose uniquement).
POSTGRES_PASSWORD=
# Mot de passe PostgreSQL de l'application (Compose uniquement).
POSTGRES_APP_PASSWORD=
# Clé aléatoire d'au moins 32 caractères pour les jetons d'accès.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Clé aléatoire pour chiffrer les secrets TOTP.
TOTP_ENCRYPTION_KEY=replace-with-a-different-random-secret
# Courriel initial du super-administrateur, utilisé par le seed local.
BOOTSTRAP_ADMIN_EMAIL=
# Mot de passe initial du super-administrateur, utilisé par le seed local.
BOOTSTRAP_ADMIN_PASSWORD=
# Origine exacte autorisée pour les appels API avec cookies.
FRONTEND_ORIGIN=http://localhost:4200
# URL publique du frontend, utilisée pour construire les liens e-mail côté serveur.
APP_PUBLIC_URL=http://localhost:4200
# Clé d’envoi Resend ; nécessaire à la récupération du mot de passe par e-mail et aux notifications e-mail.
RESEND_API_KEY=
# Adresse expéditrice vérifiée auprès du fournisseur e-mail.
MAIL_FROM=
# Âge minimum choisi par la paroisse ; valeur par défaut : 13 ans.
SOCIAL_MIN_AGE=
# Identifiant versionné de la charte approuvée ; une charte par défaut est utilisée si vide.
SOCIAL_CHARTER_VERSION=
# Texte de la charte approuvée présenté lors de l’inscription ; un texte par défaut est utilisé si vide.
SOCIAL_CHARTER_TEXT=
# Domaines d'adresses jetables refusés, séparés par des virgules.
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,10minutemail.com,guerrillamail.com,tempmail.com,yopmail.com,throwawaymail.com
# Stockage privé compatible S3 pour les médias du fil ; laisser vide désactive l’envoi.
# SOCIAL_MEDIA_ENABLED est le nom recommandé ; SOCIAL_PHOTOS_ENABLED reste accepté pour compatibilité.
SOCIAL_PHOTOS_ENABLED=false
SOCIAL_MEDIA_ENABLED=false
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true
# Hôte du démon ClamAV joignable par l’API ; les envois échouent si l’analyse n’est pas disponible.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Masquage automatique après ce nombre de signalements uniques (2–20, défaut 3).
SOCIAL_AUTO_HIDE_THRESHOLD=3
# Durée du masquage automatique (1–168 heures, défaut 48).
SOCIAL_AUTO_HIDE_HOURS=48
# CAPTCHA désactivé par défaut. Pour l’exiger, définissez true et renseignez les deux clés.
CAPTCHA_ENABLED=false
# Clé publique Cloudflare Turnstile ; requise avec CAPTCHA_ENABLED=true.
CAPTCHA_SITE_KEY=
# Clé privée Cloudflare Turnstile ; requise avec CAPTCHA_ENABLED=true.
CAPTCHA_SECRET_KEY=

# Limite de publications par période glissante de 24 h pour un compte de moins de 24 h.
SOCIAL_NEW_ACCOUNT_POSTS_PER_DAY=3
# Tolérance en minutes pour les fenêtres de saisie de présence (0 à 120).
ATTENDANCE_GRACE_MINUTES=0
# Durée de conservation des noms de présence, en mois.
DATA_RETENTION_MONTHS=12
# Durée de conservation des journaux d'audit, en mois.
AUDIT_RETENTION_MONTHS=36
# Durée de conservation des sauvegardes chiffrées, en jours.
BACKUP_RETENTION_DAYS=35
# Clé aléatoire de 32 octets en hexadécimal pour AES-256-GCM des sauvegardes.
BACKUP_KEY_HEX=
# Dossier de certificats TLS monté dans le conteneur web de production.
TLS_CERT_DIR=/absolute/path/to/tls-certificate-directory
# Port HTTP local de l'API NestJS.
PORT=3000
