# Local development only; never use this URL for migrations executed by Codex.
DATABASE_URL=postgresql://app:change-me@localhost:5432/paroisse?schema=public
# Dedicated automated-test database. Keep its name distinct and containing "test".
TEST_DATABASE_URL=postgresql://paroisse_test_user:change-me@localhost:5432/paroisse_test?schema=public
PG_ADMIN_URL=
PAROISSE_TEST_DB_PASSWORD=
PAROISSE_APP_USER=paroisse_app
PAROISSE_APP_PASSWORD=
PAROISSE_MIGRATION_USER=paroisse_migrator
PAROISSE_MIGRATION_PASSWORD=
PAROISSE_APP_DATABASE=paroisse

# PostgreSQL container secrets; generate separate random values for deployment.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_APP_DATABASE=paroisse

# Authentication secrets; use independent random values of at least 32 bytes.
JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=
# Optional second factor for presence secretaries and day presidents (default off).
2FA_REQUIS_RESPONSABLES=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FRONTEND_ORIGIN=
APP_PUBLIC_URL=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_DAYS=30

# Password recovery email service.
RESEND_API_KEY=
MAIL_FROM=
RESEND_DAILY_LIMIT=100
RESEND_ALERT_AT=80

# Attendance, data retention, and audit retention.
ATTENDANCE_GRACE_MINUTES=0
DATA_RETENTION_MONTHS=12
AUDIT_RETENTION_MONTHS=36

# Encrypted off-host backups only. S3 settings are not used for application media.
BACKUP_RETENTION_DAYS=35
BACKUP_KEY_HEX=
BACKUP_DATABASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BACKUP_KEY=
RESTORE_DATABASE_URL=
RESTORE_CONFIRM=

# TLS and public host settings for the production reverse proxy.
TLS_CERT_DIR=
DOMAIN=
LETSENCRYPT_EMAIL=
PORT=3000
