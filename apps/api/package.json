{
  "name": "@paroisse/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "npm run build && node dist/apps/api/src/main.js",
    "build": "npm run prisma:generate && nest build && node scripts/copy-prisma-client.cjs",
    "lint": "npm run prisma:generate && tsc --noEmit",
    "test": "npm run prisma:generate && jest --runInBand --cacheDirectory .jest-cache",
    "prisma:generate": "node scripts/prisma-cli.cjs generate",
    "prisma:migrate": "node scripts/prisma-cli.cjs migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:deploy": "node scripts/prisma-cli.cjs migrate deploy",
    "admin:enroll-2fa": "ts-node scripts/admin-enroll-2fa.ts",
    "admin:reset-2fa": "ts-node scripts/admin-enroll-2fa.ts",
    "test:e2e": "node scripts/security-e2e.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
