generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITEUR
  SECRETAIRE_PRESENCE
  RESPONSABLE_SEMAINE
  FIDELE
  MODERATEUR
  PENDING
}
enum SessionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
}
enum SheetType {
  COURS_BIBLIQUE
  GROUPE_SEMAINE
}
enum SheetStatus {
  OUVERTE
  ENREGISTREE
}
enum Sex {
  M
  F
}
enum Zone {
  FIDELES
  TEMPLE
  SALLE_VISION
}
enum SocialVisibility {
  TOUS_LES_FIDELES
  MOI_SEUL
}
enum SocialGroupVisibility {
  PUBLIC
  PRIVATE
}
enum SocialGroupMemberStatus {
  MEMBER
  PENDING
}
enum SocialGroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}
enum SocialReactionType {
  AIME
  COEUR
}

enum SocialEventRsvpStatus {
  PARTICIPATING
  INTERESTED
  DECLINED
}
enum SocialReportTarget {
  POST
  COMMENT
  PROFILE
}
enum SocialReportReason {
  SPAM
  HARCELEMENT
  CONTENU_INAPPROPRIE
  USURPATION
  AUTRE
}
enum SocialModerationStatus {
  OPEN
  AUTO_HIDDEN
  REVIEWED
  DISMISSED
}
enum SocialModerationPriority {
  NORMAL
  ELEVEE
  URGENTE
}
enum SocialAppealStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}
enum PersonRoleName {
  LEADER
  MONITEUR_TABLE
  RESUME_PRECEDENT
  EXPLICATION_TEXTE
  PRESENTATION_THEME
}
model Person {
  id String @id @default(cuid())
  firstName String
  lastName String
  grade String?
  photoUrl String?
  bio String?
  active Boolean @default(true)
  displayOrder Int @default(0)
  roles PersonRole[]
  assignments SessionAssignment[]
}
model PersonRole {
  personId String
  role PersonRoleName
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@id([personId, role])
}
model Session {
  id String @id @default(cuid())
  date DateTime @unique @db.Date
  startTime String @default("19:30")
  endTime String @default("21:30")
  theme String
  bibleBook String
  bibleChapter Int
  verseStart Int?
  verseEnd Int?
  bibleText String?
  bibleReference String?
  bibleDevelopment String?
  previousSummary String? @db.Text
  status SessionStatus @default(PLANIFIEE)
  assignments SessionAssignment[]
  sheets AttendanceSheet[]
}
model SessionAssignment {
  sessionId String
  personId String
  role PersonRoleName
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])
  @@id([sessionId, personId, role])
}
model AttendanceSheet {
  id String @id @default(cuid())
  type SheetType
  date DateTime @db.Date
  sessionId String?
  status SheetStatus @default(OUVERTE)
  totalsByZone Json?
  totalMen Int @default(0)
  totalWomen Int @default(0)
  totalAll Int @default(0)
  submittedById String?
  submittedAt DateTime?
  entries AttendanceEntry[]
  session Session? @relation(fields: [sessionId], references: [id])
  @@unique([type, date])
  @@index([date])
}
model AttendanceEntry {
  id String @id @default(cuid())
  sheetId String
  clientUuid String
  fullName String?
  normalizedName String?
  sex Sex
  zone Zone
  arrivedAt DateTime @default(now())
  createdById String?
  sheet AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  @@unique([sheetId, clientUuid])
  @@index([sheetId, zone])
  @@index([sheetId, normalizedName])
}
model User {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  fullName String?
  phone String?
  email String @unique
  passwordHash String
  role UserRole
  requestedRole UserRole?
  requestedWeekStart DateTime? @db.Date
  assignedWeekStart DateTime? @db.Date
  requestedDayOfWeek Int?
  assignedDayOfWeek Int?
  active Boolean @default(true)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  totpSecret String?
  permissions String[] @default([])
  dateOfBirth DateTime? @db.Date
  emailVerifiedAt DateTime?
  charterVersion String?
  charterAcceptedAt DateTime?
  suspendedAt DateTime?
  suspensionReason String? @db.Text
  suspendedUntil DateTime?
  socialNotificationsEnabled Boolean @default(true)
  socialBio String? @db.VarChar(500)
  moderationProfileHidden Boolean @default(false)
  moderationProfileHiddenUntil DateTime?
  socialProfileDiscoverable Boolean @default(true)
  deletionScheduledAt DateTime?
  recoveryCodes RecoveryCode[]
  refreshTokens RefreshToken[]
  notifications UserNotification[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  socialPosts SocialPost[]
  socialMedia SocialPostMedia[]
  socialComments SocialComment[]
  socialReactions SocialReaction[]
  socialShares SocialShare[]
  socialSavedPosts SocialSavedPost[]
  socialHiddenPosts SocialHiddenPost[]
  socialBlocksFrom SocialBlock[] @relation("SocialBlocker")
  socialBlocksTo SocialBlock[] @relation("SocialBlocked")
  socialGroupsOwned SocialGroup[] @relation("SocialGroupOwner")
  socialGroupMemberships SocialGroupMembership[]
  socialGroupPosts SocialGroupPost[]
  socialGroupComments SocialGroupComment[]
  socialPollVotes SocialPollVote[]
  socialEventRsvps SocialEventRsvp[]
  socialReports SocialReport[]
  sanctionsReceived SocialSanction[] @relation("SanctionTarget")
  sanctionsIssued SocialSanction[] @relation("SanctionIssuer")
  appealDecisions SocialSanction[] @relation("SanctionAppealDecider")
}

model SocialPost {
  id String @id @default(cuid())
  authorId String
  body String @db.Text
  visibility SocialVisibility @default(TOUS_LES_FIDELES)
  pinned Boolean @default(false)
  idempotencyKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sourcePostId String?
  sourcePost SocialPost? @relation("SocialReposts", fields: [sourcePostId], references: [id], onDelete: Cascade)
  reposts SocialPost[] @relation("SocialReposts")
  comments SocialComment[]
  reactions SocialReaction[]
  shares SocialShare[]
  saves SocialSavedPost[]
  hiddenBy SocialHiddenPost[]
  media SocialPostMedia[]
  poll SocialPoll?
  event SocialEvent?
  moderationHidden Boolean @default(false)
  moderationHiddenUntil DateTime?
  @@unique([authorId, idempotencyKey])
  @@index([visibility, createdAt, id])
  @@index([authorId, createdAt])
}

model SocialPostMedia {
  id String @id @default(cuid())
  postId String
  uploadedById String
  objectKey String @unique
  mimeType String
  byteSize Int
  width Int
  height Int
  position Int @default(0)
  createdAt DateTime @default(now())
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  @@index([postId, position])
}

model SocialPoll {
  id String @id @default(cuid())
  postId String @unique
  closesAt DateTime?
  createdAt DateTime @default(now())
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  options SocialPollOption[]
  votes SocialPollVote[]
  @@index([closesAt])
}

model SocialPollOption {
  id String @id @default(cuid())
  pollId String
  text String @db.VarChar(120)
  position Int
  poll SocialPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes SocialPollVote[]
  @@unique([id, pollId])
  @@unique([pollId, position])
  @@index([pollId, position])
}

model SocialPollVote {
  pollId String
  optionId String
  userId String
  createdAt DateTime @default(now())
  poll SocialPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option SocialPollOption @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([pollId, userId])
  @@index([optionId, pollId])
  @@index([userId, createdAt])
}

model SocialEvent {
  id String @id @default(cuid())
  postId String @unique
  title String @db.VarChar(160)
  startsAt DateTime
  endsAt DateTime?
  location String? @db.VarChar(200)
  createdAt DateTime @default(now())
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  rsvps SocialEventRsvp[]
  @@index([startsAt])
}

model SocialEventRsvp {
  eventId String
  userId String
  status SocialEventRsvpStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event SocialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
  @@index([userId, createdAt])
}

model SocialComment {
  id String @id @default(cuid())
  postId String
  authorId String
  parentId String?
  body String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent SocialComment? @relation("SocialCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies SocialComment[] @relation("SocialCommentReplies")
  reactions SocialReaction[]
  moderationHidden Boolean @default(false)
  moderationHiddenUntil DateTime?
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model SocialReaction {
  id String @id @default(cuid())
  userId String
  postId String?
  commentId String?
  targetKey String
  type SocialReactionType
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment SocialComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@unique([userId, targetKey, type])
  @@index([targetKey])
}

model SocialShare {
  id String @id @default(cuid())
  userId String
  postId String
  body String? @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@index([createdAt])
}

model SocialSavedPost {
  id String @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model SocialHiddenPost {
  id String @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model SocialBlock {
  id String @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
model SocialGroup {
  id String @id @default(cuid())
  name String @db.VarChar(100)
  description String @db.VarChar(500)
  visibility SocialGroupVisibility @default(PUBLIC)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("SocialGroupOwner", fields: [createdById], references: [id], onDelete: Cascade)
  memberships SocialGroupMembership[]
  posts SocialGroupPost[]
  @@index([visibility, createdAt])
  @@index([createdById, createdAt])
}
model SocialGroupMembership {
  id String @id @default(cuid())
  groupId String
  userId String
  role SocialGroupMemberRole @default(MEMBER)
  status SocialGroupMemberStatus @default(MEMBER)
  createdAt DateTime @default(now())
  group SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status, createdAt])
}
model SocialGroupPost {
  id String @id @default(cuid())
  groupId String
  authorId String
  idempotencyKey String
  body String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  group SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments SocialGroupComment[]
  @@unique([groupId, authorId, idempotencyKey])
  @@index([groupId, createdAt, id])
  @@index([authorId, createdAt])
}
model SocialGroupComment {
  id String @id @default(cuid())
  postId String
  authorId String
  body String @db.Text
  createdAt DateTime @default(now())
  deletedAt DateTime?
  post SocialGroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}
model SocialModerationCase {
  id String @id @default(cuid())
  targetType SocialReportTarget
  targetId String
  targetAuthorId String
  status SocialModerationStatus @default(OPEN)
  priority SocialModerationPriority @default(NORMAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  reports SocialReport[]
  events SocialModerationEvent[]
  sanctions SocialSanction[]
  @@unique([targetType, targetId])
  @@index([status, priority, updatedAt])
  @@index([targetAuthorId, createdAt])
}
model SocialReport {
  id String @id @default(cuid())
  caseId String
  reporterId String
  reason SocialReportReason
  createdAt DateTime @default(now())
  moderationCase SocialModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([caseId, reporterId])
  @@index([createdAt])
}
model SocialModerationEvent {
  id String @id @default(cuid())
  caseId String
  actorId String?
  action String
  reason String
  until DateTime?
  createdAt DateTime @default(now())
  moderationCase SocialModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId, createdAt])
}
model SocialSanction {
  id String @id @default(cuid())
  caseId String
  targetUserId String
  createdById String
  reason String
  suspendedUntil DateTime?
  permanent Boolean @default(false)
  appealStatus SocialAppealStatus @default(NONE)
  appealedAt DateTime?
  appealReason String?
  appealDecidedById String?
  appealDecisionReason String?
  appealDecidedAt DateTime?
  createdAt DateTime @default(now())
  moderationCase SocialModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  target User @relation("SanctionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  issuer User @relation("SanctionIssuer", fields: [createdById], references: [id], onDelete: Restrict)
  appealDecider User? @relation("SanctionAppealDecider", fields: [appealDecidedById], references: [id], onDelete: SetNull)
  @@index([targetUserId, suspendedUntil])
  @@index([appealStatus, createdAt])
}
model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model UserNotification {
  id String @id @default(cuid())
  userId String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
model RefreshToken {
  id String @id @default(cuid())
  userId String
  hashedToken String @unique
  expiresAt DateTime
  revokedAt DateTime?
  family String
  createdAt DateTime @default(now())
  ip String?
  userAgent String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RecoveryCode {
  id String @id @default(cuid())
  userId String
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String
  before Json?
  after Json?
  reason String?
  ip String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String
  published Boolean @default(false)
  createdAt DateTime @default(now())
}
