generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITEUR
  SECRETAIRE_PRESENCE
  RESPONSABLE_SEMAINE
  FIDELE
  MODERATEUR
  PENDING
}
enum SessionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
}
enum SheetType {
  COURS_BIBLIQUE
  GROUPE_SEMAINE
}
enum SheetStatus {
  OUVERTE
  ENREGISTREE
}
enum Sex {
  M
  F
}
enum Zone {
  FIDELES
  TEMPLE
  SALLE_VISION
}
enum SocialVisibility {
  TOUS_LES_FIDELES
  MOI_SEUL
}
enum SocialReactionType {
  AIME
  COEUR
}
enum PersonRoleName {
  LEADER
  MONITEUR_TABLE
  RESUME_PRECEDENT
  EXPLICATION_TEXTE
  PRESENTATION_THEME
}
model Person {
  id String @id @default(cuid())
  firstName String
  lastName String
  grade String?
  photoUrl String?
  bio String?
  active Boolean @default(true)
  displayOrder Int @default(0)
  roles PersonRole[]
  assignments SessionAssignment[]
}
model PersonRole {
  personId String
  role PersonRoleName
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@id([personId, role])
}
model Session {
  id String @id @default(cuid())
  date DateTime @unique @db.Date
  startTime String @default("19:30")
  endTime String @default("21:30")
  theme String
  bibleBook String
  bibleChapter Int
  verseStart Int?
  verseEnd Int?
  bibleText String?
  bibleReference String?
  bibleDevelopment String?
  previousSummary String? @db.Text
  status SessionStatus @default(PLANIFIEE)
  assignments SessionAssignment[]
  sheets AttendanceSheet[]
}
model SessionAssignment {
  sessionId String
  personId String
  role PersonRoleName
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])
  @@id([sessionId, personId, role])
}
model AttendanceSheet {
  id String @id @default(cuid())
  type SheetType
  date DateTime @db.Date
  sessionId String?
  status SheetStatus @default(OUVERTE)
  totalsByZone Json?
  totalMen Int @default(0)
  totalWomen Int @default(0)
  totalAll Int @default(0)
  submittedById String?
  submittedAt DateTime?
  entries AttendanceEntry[]
  session Session? @relation(fields: [sessionId], references: [id])
  @@unique([type, date])
  @@index([date])
}
model AttendanceEntry {
  id String @id @default(cuid())
  sheetId String
  clientUuid String
  fullName String?
  normalizedName String?
  sex Sex
  zone Zone
  arrivedAt DateTime @default(now())
  createdById String?
  sheet AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  @@unique([sheetId, clientUuid])
  @@index([sheetId, zone])
  @@index([sheetId, normalizedName])
}
model User {
  id String @id @default(cuid())
  fullName String?
  phone String?
  email String @unique
  passwordHash String
  role UserRole
  requestedRole UserRole?
  requestedWeekStart DateTime? @db.Date
  assignedWeekStart DateTime? @db.Date
  requestedDayOfWeek Int?
  assignedDayOfWeek Int?
  active Boolean @default(true)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  totpSecret String?
  permissions String[] @default([])
  dateOfBirth DateTime? @db.Date
  emailVerifiedAt DateTime?
  charterVersion String?
  charterAcceptedAt DateTime?
  suspendedAt DateTime?
  suspensionReason String? @db.Text
  suspendedUntil DateTime?
  socialNotificationsEnabled Boolean @default(true)
  recoveryCodes RecoveryCode[]
  refreshTokens RefreshToken[]
  notifications UserNotification[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  socialPosts SocialPost[]
  socialComments SocialComment[]
  socialReactions SocialReaction[]
  socialShares SocialShare[]
  socialSavedPosts SocialSavedPost[]
  socialHiddenPosts SocialHiddenPost[]
  socialBlocksFrom SocialBlock[] @relation("SocialBlocker")
  socialBlocksTo SocialBlock[] @relation("SocialBlocked")
}

model SocialPost {
  id String @id @default(cuid())
  authorId String
  body String @db.Text
  visibility SocialVisibility @default(TOUS_LES_FIDELES)
  pinned Boolean @default(false)
  idempotencyKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sourcePostId String?
  sourcePost SocialPost? @relation("SocialReposts", fields: [sourcePostId], references: [id], onDelete: Cascade)
  reposts SocialPost[] @relation("SocialReposts")
  comments SocialComment[]
  reactions SocialReaction[]
  shares SocialShare[]
  saves SocialSavedPost[]
  hiddenBy SocialHiddenPost[]
  @@unique([authorId, idempotencyKey])
  @@index([visibility, createdAt, id])
  @@index([authorId, createdAt])
}

model SocialComment {
  id String @id @default(cuid())
  postId String
  authorId String
  parentId String?
  body String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent SocialComment? @relation("SocialCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies SocialComment[] @relation("SocialCommentReplies")
  reactions SocialReaction[]
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model SocialReaction {
  id String @id @default(cuid())
  userId String
  postId String?
  commentId String?
  targetKey String
  type SocialReactionType
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment SocialComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@unique([userId, targetKey, type])
  @@index([targetKey])
}

model SocialShare {
  id String @id @default(cuid())
  userId String
  postId String
  body String? @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@index([createdAt])
}

model SocialSavedPost {
  id String @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model SocialHiddenPost {
  id String @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model SocialBlock {
  id String @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model UserNotification {
  id String @id @default(cuid())
  userId String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
model RefreshToken {
  id String @id @default(cuid())
  userId String
  hashedToken String @unique
  expiresAt DateTime
  revokedAt DateTime?
  family String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RecoveryCode {
  id String @id @default(cuid())
  userId String
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String
  before Json?
  after Json?
  reason String?
  ip String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String
  published Boolean @default(false)
  createdAt DateTime @default(now())
}
