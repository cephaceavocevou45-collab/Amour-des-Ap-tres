generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITEUR
  SECRETAIRE_PRESENCE
  RESPONSABLE_SEMAINE
  FIDELE
  MODERATEUR
  PENDING
}
enum SessionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
}
enum SheetType {
  COURS_BIBLIQUE
  GROUPE_SEMAINE
}
enum SheetStatus {
  OUVERTE
  ENREGISTREE
}
enum Sex {
  M
  F
}
enum Zone {
  FIDELES
  TEMPLE
  SALLE_VISION
}
enum PersonRoleName {
  LEADER
  MONITEUR_TABLE
  RESUME_PRECEDENT
  EXPLICATION_TEXTE
  PRESENTATION_THEME
}
model Person {
  id String @id @default(cuid())
  firstName String
  lastName String
  grade String?
  photoUrl String?
  bio String?
  active Boolean @default(true)
  displayOrder Int @default(0)
  roles PersonRole[]
  assignments SessionAssignment[]
}
model PersonRole {
  personId String
  role PersonRoleName
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@id([personId, role])
}
model Session {
  id String @id @default(cuid())
  date DateTime @unique @db.Date
  startTime String @default("19:30")
  endTime String @default("21:30")
  theme String
  bibleBook String
  bibleChapter Int
  verseStart Int?
  verseEnd Int?
  bibleText String?
  bibleReference String?
  bibleDevelopment String?
  previousSummary String? @db.Text
  status SessionStatus @default(PLANIFIEE)
  assignments SessionAssignment[]
  sheets AttendanceSheet[]
}
model SessionAssignment {
  sessionId String
  personId String
  role PersonRoleName
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])
  @@id([sessionId, personId, role])
}
model AttendanceSheet {
  id String @id @default(cuid())
  type SheetType
  date DateTime @db.Date
  sessionId String?
  status SheetStatus @default(OUVERTE)
  totalsByZone Json?
  totalMen Int @default(0)
  totalWomen Int @default(0)
  totalAll Int @default(0)
  submittedById String?
  submittedAt DateTime?
  entries AttendanceEntry[]
  session Session? @relation(fields: [sessionId], references: [id])
  @@unique([type, date])
  @@index([date])
}
model AttendanceEntry {
  id String @id @default(cuid())
  sheetId String
  clientUuid String
  fullName String?
  normalizedName String?
  sex Sex
  zone Zone
  arrivedAt DateTime @default(now())
  createdById String?
  sheet AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  @@unique([sheetId, clientUuid])
  @@index([sheetId, zone])
  @@index([sheetId, normalizedName])
}
model User {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  fullName String?
  phone String?
  email String @unique
  passwordHash String
  role UserRole
  requestedRole UserRole?
  requestedWeekStart DateTime? @db.Date
  assignedWeekStart DateTime? @db.Date
  requestedDayOfWeek Int?
  assignedDayOfWeek Int?
  active Boolean @default(true)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  totpSecret String?
  permissions String[] @default([])
  dateOfBirth DateTime? @db.Date
  emailVerifiedAt DateTime?
  charterVersion String?
  charterAcceptedAt DateTime?
  suspendedAt DateTime?
  suspensionReason String? @db.Text
  suspendedUntil DateTime?
  socialNotificationsEnabled Boolean @default(true)
  socialBio String? @db.VarChar(500)
  moderationProfileHidden Boolean @default(false)
  moderationProfileHiddenUntil DateTime?
  socialProfileDiscoverable Boolean @default(true)
  deletionScheduledAt DateTime?
  recoveryCodes RecoveryCode[]
  refreshTokens RefreshToken[]
  notifications UserNotification[]
  queuedEmails EmailOutbox[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  socialBlocksFrom SocialBlock[] @relation("SocialBlocker")
  socialBlocksTo SocialBlock[] @relation("SocialBlocked")
  sentMessages CommunityMessage[] @relation("MessageSender")
  conversationMemberships CommunityConversationMember[]
  messageReactions CommunityMessageReaction[]
  messageReports CommunityMessageReport[]
  messageReportDecisions CommunityMessageReport[] @relation("MessageReportDecision")
  communityStories CommunityStory[]
  storyReports CommunityStoryReport[] @relation("CommunityStoryReporter")
  storyReportDecisions CommunityStoryReport[] @relation("CommunityStoryDecision")
  hostedCommunityLives CommunityLive[] @relation("CommunityLiveHost")
  communityLiveParticipations CommunityLiveParticipant[]
  sentCommunityLiveSignals CommunityLiveSignal[] @relation("CommunityLiveSignalSender")
  receivedCommunityLiveSignals CommunityLiveSignal[] @relation("CommunityLiveSignalReceiver")
  parishContentCreated ParishContent[] @relation("ParishContentAuthor")
  parishContentUpdated ParishContent[] @relation("ParishContentEditor")
  bibleStudyThemes BibleStudyTheme[]
  parishHistoryEntries ParishHistoryEntry[]
  groupJoinRequests GroupJoinRequest[]
}

enum ParishContentKind {
  PROGRAMME
  EVENEMENT
}

model ParishContent {
  id String @id @default(cuid())
  kind ParishContentKind
  title String @db.VarChar(160)
  body String @db.VarChar(5000)
  location String? @db.VarChar(240)
  startsAt DateTime?
  endsAt DateTime?
  publishedAt DateTime?
  authorId String
  editorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation("ParishContentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editor User? @relation("ParishContentEditor", fields: [editorId], references: [id], onDelete: SetNull)
  @@index([kind, publishedAt, startsAt])
  @@index([authorId, updatedAt])
}

model BibleStudyTheme {
  id String @id @default(cuid())
  studyDate DateTime @unique @db.Date
  title String @db.VarChar(240)
  bibleReference String? @db.VarChar(240)
  summary String? @db.VarChar(5000)
  publishedAt DateTime?
  editorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editor User @relation(fields: [editorId], references: [id], onDelete: Restrict)
  @@index([publishedAt, studyDate])
}

model ParishHistoryEntry {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  body String @db.VarChar(10000)
  publishedAt DateTime?
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([publishedAt, createdAt])
}

enum CommunityConversationType {
  DIRECT
  GROUP
}

enum GroupVisibility {
  OPEN_REQUEST
  PRIVATE_CODE
}

enum GroupMemberRole {
  CREATOR
  ADMIN_GROUPE
  MEMBER
}

enum GroupJoinStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

model CommunityConversation {
  id String @id @default(cuid())
  type CommunityConversationType
  title String? @db.VarChar(100)
  joinCodeHash String? @unique
  directKey String? @unique
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?
  visibility GroupVisibility @default(PRIVATE_CODE)
  description String? @db.VarChar(1000)
  rules String? @db.VarChar(2000)
  members CommunityConversationMember[]
  messages CommunityMessage[]
  joinRequests GroupJoinRequest[]
  @@index([updatedAt, id])
}

model CommunityConversationMember {
  conversationId String
  userId String
  joinedAt DateTime @default(now())
  leftAt DateTime?
  lastReadAt DateTime?
  mutedUntil DateTime?
  groupRole GroupMemberRole @default(MEMBER)
  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId, leftAt, lastReadAt])
}

model GroupJoinRequest {
  id String @id @default(cuid())
  conversationId String
  requesterId String
  note String? @db.VarChar(500)
  status GroupJoinStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decidedAt DateTime?
  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  @@unique([conversationId, requesterId])
  @@index([conversationId, status, createdAt])
  @@index([requesterId, status, updatedAt])
}

model CommunityMessage {
  id String @id @default(cuid())
  conversationId String
  senderId String
  replyToId String?
  body String @db.VarChar(5000)
  idempotencyKey String
  createdAt DateTime @default(now())
  editedAt DateTime?
  deletedAt DateTime?
  moderationHidden Boolean @default(false)
  moderationHiddenUntil DateTime?
  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo CommunityMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies CommunityMessage[] @relation("MessageReplies")
  reactions CommunityMessageReaction[]
  reports CommunityMessageReport[]
  @@unique([senderId, idempotencyKey])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
}

model CommunityMessageReaction {
  messageId String
  userId String
  emoji String @db.VarChar(16)
  createdAt DateTime @default(now())
  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([messageId, userId, emoji])
  @@index([userId, createdAt])
}

model CommunityMessageReport {
  id String @id @default(cuid())
  messageId String
  reporterId String
  reason String
  detail String? @db.VarChar(1000)
  status String @default("OPEN") @db.VarChar(20)
  decisionReason String? @db.VarChar(1000)
  decidedById String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("MessageReportDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  @@unique([messageId, reporterId])
  @@index([createdAt])
}

model CommunityStory {
  id String @id @default(cuid())
  authorId String
  body String @db.VarChar(500)
  createdAt DateTime @default(now())
  expiresAt DateTime
  moderationHidden Boolean @default(false)
  moderationHiddenUntil DateTime?
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports CommunityStoryReport[]
  @@index([expiresAt, createdAt])
  @@index([authorId, createdAt])
}

model CommunityStoryReport {
  id String @id @default(cuid())
  storyId String
  reporterId String
  reason String @db.VarChar(32)
  detail String? @db.VarChar(1000)
  status String @default("OPEN") @db.VarChar(20)
  decisionReason String? @db.VarChar(1000)
  decidedById String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporter User @relation("CommunityStoryReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("CommunityStoryDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  @@unique([storyId, reporterId])
  @@index([status, createdAt])
}

model CommunityLive {
  id String @id @default(cuid())
  hostId String
  title String @db.VarChar(100)
  createdAt DateTime @default(now())
  endedAt DateTime?
  host User @relation("CommunityLiveHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants CommunityLiveParticipant[]
  signals CommunityLiveSignal[]
  @@index([endedAt, createdAt])
  @@index([hostId, endedAt])
}

model CommunityLiveParticipant {
  liveId String
  userId String
  role String @db.VarChar(8)
  joinedAt DateTime @default(now())
  leftAt DateTime?
  live CommunityLive @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([liveId, userId])
  @@index([userId, leftAt])
}

model CommunityLiveSignal {
  id String @id @default(cuid())
  liveId String
  senderId String
  targetId String
  kind String @db.VarChar(12)
  payload String @db.VarChar(20000)
  createdAt DateTime @default(now())
  live CommunityLive @relation(fields: [liveId], references: [id], onDelete: Cascade)
  sender User @relation("CommunityLiveSignalSender", fields: [senderId], references: [id], onDelete: Cascade)
  target User @relation("CommunityLiveSignalReceiver", fields: [targetId], references: [id], onDelete: Cascade)
  @@index([liveId, targetId, createdAt])
}

model SocialBlock {
  id String @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model UserNotification {
  id String @id @default(cuid())
  userId String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model EmailDailyUsage {
  day DateTime @id @db.Date
  sentCount Int @default(0)
  alertSent Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model EmailOutbox {
  id String @id @default(cuid())
  userId String
  template String @db.VarChar(40)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([sentAt, nextAttemptAt, createdAt])
}

model RefreshToken {
  id String @id @default(cuid())
  userId String
  hashedToken String @unique
  expiresAt DateTime
  revokedAt DateTime?
  family String
  createdAt DateTime @default(now())
  ip String?
  userAgent String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RecoveryCode {
  id String @id @default(cuid())
  userId String
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String
  before Json?
  after Json?
  reason String?
  ip String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String
  published Boolean @default(false)
  createdAt DateTime @default(now())
}
