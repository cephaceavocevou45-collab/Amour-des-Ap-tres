generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITEUR
  SECRETAIRE_PRESENCE
  SECRETAIRE_PROGRAMME
  TRESORIER
  RESPONSABLE_SEMAINE
  FIDELE
}
enum SessionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
}
enum SheetType {
  COURS_BIBLIQUE
  GROUPE_SEMAINE
}
enum SheetStatus {
  OUVERTE
  ENREGISTREE
}
enum Sex {
  M
  F
}
enum WeekProgramStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}
enum TreasuryKind {
  RECETTE
  DEPENSE
}
enum Zone {
  FIDELES
  TEMPLE
  SALLE_VISION
}
enum PersonRoleName {
  LEADER
  MONITEUR_TABLE
  RESUME_PRECEDENT
  EXPLICATION_TEXTE
  PRESENTATION_THEME
}
model Person {
  id String @id @default(cuid())
  firstName String
  lastName String
  grade String?
  photoUrl String?
  bio String?
  active Boolean @default(true)
  displayOrder Int @default(0)
  roles PersonRole[]
  assignments SessionAssignment[]
}
model PersonRole {
  personId String
  role PersonRoleName
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@id([personId, role])
}
model Session {
  id String @id @default(cuid())
  date DateTime @unique @db.Date
  startTime String @default("19:30")
  endTime String @default("21:30")
  theme String
  bibleBook String
  bibleChapter Int
  verseStart Int?
  verseEnd Int?
  bibleText String?
  bibleReference String?
  bibleDevelopment String?
  previousSummary String? @db.Text
  status SessionStatus @default(PLANIFIEE)
  assignments SessionAssignment[]
  sheets AttendanceSheet[]
}
model SessionAssignment {
  sessionId String
  personId String
  role PersonRoleName
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])
  @@id([sessionId, personId, role])
}
model AttendanceSheet {
  id String @id @default(cuid())
  type SheetType
  date DateTime @db.Date
  sessionId String?
  status SheetStatus @default(OUVERTE)
  totalsByZone Json?
  totalMen Int @default(0)
  totalWomen Int @default(0)
  totalAll Int @default(0)
  submittedById String?
  submittedAt DateTime?
  entries AttendanceEntry[]
  session Session? @relation(fields: [sessionId], references: [id])
  @@unique([type, date])
  @@index([date])
}
model AttendanceEntry {
  id String @id @default(cuid())
  sheetId String
  clientUuid String
  fullName String?
  normalizedName String?
  sex Sex
  zone Zone
  arrivedAt DateTime @default(now())
  createdById String?
  sheet AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  @@unique([sheetId, clientUuid])
  @@index([sheetId, zone])
  @@index([sheetId, normalizedName])
}
model User {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  fullName String?
  firstName String?
  lastName String?
  grade String?
  parish String?
  functionName String?
  phone String?
  email String @unique
  passwordHash String
  mustChangePassword Boolean @default(false)
  role UserRole
  assignedDayOfWeek Int?
  active Boolean @default(true)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  permissions String[] @default([])
  canRespondMessages Boolean @default(false)
  welcomeShownAt DateTime?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  parishAnnouncements Announcement[]
  weekPrograms WeekProgram[]
  treasuryEntries TreasuryEntry[]
  openedConversations Conversation[] @relation("ConversationRequester")
  assignedConversations Conversation[] @relation("ConversationResponder")
  sentMessages Message[]
  notifications Notification[]
  meetingRequests MeetingRequest[]
  handledMeetings MeetingRequest[] @relation("MeetingHandler")
}

model Conversation {
  id String @id @default(cuid())
  subject String @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requesterId String
  assignedToId String?
  requester User @relation("ConversationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("ConversationResponder", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages Message[]
  @@index([requesterId, updatedAt])
  @@index([assignedToId, updatedAt])
}

model Message {
  id String @id @default(cuid())
  body String @db.VarChar(4000)
  createdAt DateTime @default(now())
  conversationId String
  senderId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([conversationId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  body String @db.VarChar(500)
  href String @db.VarChar(240)
  createdAt DateTime @default(now())
  readAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model MeetingRequest {
  id String @id @default(cuid())
  preferredAt DateTime
  subject String @db.VarChar(160)
  message String @db.VarChar(2000)
  status String @default("EN_ATTENTE") @db.VarChar(24)
  createdAt DateTime @default(now())
  requesterId String
  handledById String?
  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  handledBy User? @relation("MeetingHandler", fields: [handledById], references: [id], onDelete: SetNull)
  @@index([status, preferredAt])
  @@index([requesterId, createdAt])
}

model Announcement {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  body String @db.Text
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([published, createdAt])
}

model WeekProgram {
  id String @id @default(cuid())
  title String @db.VarChar(160)
  weekStart DateTime @db.Date
  weekEnd DateTime @db.Date
  theme String? @db.VarChar(300)
  templateType String @default("WEEKLY") @db.VarChar(32)
  templateData Json?
  status WeekProgramStatus @default(BROUILLON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  entries WeekProgramEntry[]
  @@index([status, weekStart])
  @@index([authorId, createdAt])
}

model WeekProgramEntry {
  id String @id @default(cuid())
  programId String
  date DateTime @db.Date
  startTime String? @db.VarChar(5)
  endTime String? @db.VarChar(5)
  category String @db.VarChar(80)
  title String @db.VarChar(180)
  people String[] @default([])
  details String? @db.VarChar(3000)
  imageUrl String? @db.VarChar(1000)
  displayOrder Int @default(0)
  program WeekProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@index([programId, date, displayOrder])
}

model TreasuryEntry {
  id String @id @default(cuid())
  kind TreasuryKind
  amountXof Int
  occurredAt DateTime @db.Date
  category String @db.VarChar(100)
  description String @db.VarChar(1000)
  reference String? @db.VarChar(160)
  receiptUrl String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([occurredAt, kind])
  @@index([authorId, createdAt])
}




















model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  failedAttempts Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailDailyUsage {
  day DateTime @id @db.Date
  sentCount Int @default(0)
  alertSent Boolean @default(false)
  updatedAt DateTime @updatedAt
}


model RefreshToken {
  id String @id @default(cuid())
  userId String
  hashedToken String @unique
  expiresAt DateTime
  revokedAt DateTime?
  family String
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip String?
  userAgent String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String
  before Json?
  after Json?
  reason String?
  ip String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}
